# Required. Every LLM call goes through Groq. https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Optional. Only raises the GitHub API rate limit for fetch_node.
GITHUB_TOKEN="your_github_token_here"

# Optional model override. Defaults to openai/gpt-oss-120b.
# Must support tool calling if used for verification.
# GROQ_MODEL=openai/gpt-oss-120b
